# Copy to .env (gitignored) and fill in. Read by `make chaos-diagnose`,
# `make chaos-pr`, `make remediate`, `make quarantine-sync` and the warehouse
# verify targets; a variable exported in your shell takes priority.
#
# AI remediation layer: Claude API key, from console.anthropic.com
ANTHROPIC_API_KEY=

# The dbt-ecom-remediation GitHub App, so PRs, issues and comments come from
# dbt-ecom-remediation[bot] rather than from you (docs/ai-remediation.md).
# Keep the private key outside the repo.
REMEDIATION_APP_ID=
REMEDIATION_APP_KEY_FILE=~/.config/dbt-ecom-remediation/private-key.pem