# Snowflake credentials for this dbt project.
#
# Copy to .env.snowflake (gitignored), fill in, then:
#     ENV_FILE=.env.snowflake make check-env             TARGET=snowflake_prod
#     ENV_FILE=.env.snowflake make verify-warehouse-smoke TARGET=snowflake_prod
#     ENV_FILE=.env.snowflake make verify-warehouse       TARGET=snowflake_prod
#
# Why a file per warehouse: profiles.yml reads the same DB_TRANSFORM_USER and
# DB_TRANSFORM_PASSWORD for every target, so a single .env can only describe
# one warehouse at a time. Keeping .env.snowflake and .env.redshift side by
# side means testing one does not overwrite the other's credentials.
#
# dbt Core does NOT read .env files itself -- dbt Cloud and Dagster do, which
# catches people out. The make targets load this file via scripts/with_env.py.
# A bare `dbt build` needs these exported in your shell, or use:
#     make dbt CMD="build --target snowflake_prod"
#
# Values are parsed literally, not sourced through a shell, so a password
# containing \ $ ` or # survives intact. One layer of surrounding quotes is
# stripped if present.

# --- Account ---------------------------------------------------------------
# The account identifier, e.g. ORGNAME-ACCOUNTNAME.
# In Snowsight: bottom-left account menu -> Copy account identifier.
# NOT the full https://....snowflakecomputing.com URL.
SNOWFLAKE_ACCOUNT=XXX

# --- Credentials -----------------------------------------------------------
# The user dbt authenticates as.
DB_TRANSFORM_USER=TRANSFORM

# Quote it: harmless, and it matters if the password contains a space or a #.
#
# Two things that will silently reject a correct-looking password:
#  - A JSON-escaped value. `terraform output` without -raw, a Secrets Manager
#    payload or a CloudFormation response all escape special characters, and
#    the literal text is then not the password. Use:
#        terraform output -raw <password_output_name>
#  - MUST_CHANGE_PASSWORD on the Snowflake user. Terraform-created users often
#    have it set, which lets the original password work for an interactive
#    Snowsight login while rejecting every driver connection. If you changed it
#    in the UI, the new one belongs here.
DB_TRANSFORM_PASSWORD='XXX'

# --- Compute and target ----------------------------------------------------
# This role needs CREATE SCHEMA on DB_TRANSFORM_DATABASE. The project creates
# four schemas -- extract, seeds, snapshots and transform -- because custom
# schemas are absolute rather than prefixed (macros/generate_schema_name.sql).
SNOWFLAKE_TRANSFORM_ROLE=TRANSFORM_ROLE

# An XSMALL auto-suspend warehouse is ample: a full build is ~25 seconds.
SNOWFLAKE_TRANSFORM_WAREHOUSE=TRANSFORM_WH

# Point this at a database dedicated to this project. Because the schema names
# above are fixed regardless of target, two targets sharing a database would
# overwrite each other's seeds and snapshot history.
DB_TRANSFORM_DATABASE=TRANSFORM
